{
  "name": "multiplayer-server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "varlock-wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "varlock-wrangler dev",
    "deploy": "varlock-wrangler deploy",
    "typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "env:load": "varlock load"
  },
  "dependencies": {
    "@hocuspocus/extension-logger": "^4.8.0",
    "@hocuspocus/extension-throttle": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@varlock/cloudflare-integration": "^1.6.3",
    "varlock": "^1.24.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  }
}
