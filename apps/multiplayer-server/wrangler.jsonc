{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./index.ts",
  "name": "dropnote-multiplayer",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "MULTIPLAYER",
        "class_name": "MultiplayerServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MultiplayerServer"]
    }
  ]
}
