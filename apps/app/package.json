    "@repo/editor": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/product": "workspace:*",
    "@repo/seo": "workspace:*",
    "@varlock/nextjs-integration": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "mongoose": "^9.11.4",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-haiku": "^2.4.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
